# Скопируй в .env и поменяй значения
POSTGRES_USER=office
POSTGRES_PASSWORD=office
POSTGRES_DB=office

# Секрет для подписи JWT — обязательно свой:
# openssl rand -hex 32
JWT_SECRET=change-me-in-env

# Часовой пояс офиса (в нём считается "сегодня")
OFFICE_TZ=Europe/Moscow

# На каком порту сайт будет виден в локальной сети
WEB_PORT=8080
